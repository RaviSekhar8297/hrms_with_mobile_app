# =============================================================================
# Backend env — pick the DATABASE_URL / Keycloak host for your machine
# =============================================================================

# --- Supabase PostgreSQL (VPS app -> office-LAN Supavisor pooler :8801) ---
# Username must be postgres.<POOLER_TENANT_ID> (self-hosted default: your-tenant-id)
DATABASE_URL="postgresql://postgres.your-tenant-id:YOUR_PASSWORD@183.82.117.36:8801/postgres?schema=hrms"
# Direct Postgres (office LAN only, not published to this VPS):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@183.82.117.36:5432/postgres?schema=hrms"
# Backend running on the same machine as Postgres:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=hrms"

# --- Keycloak ---
# Local:
# KEYCLOAK_AUTH_SERVER_URL="http://localhost:8080"
# Office LAN / VPS backend reaching office Keycloak:
KEYCLOAK_REALM="hrms"
KEYCLOAK_AUTH_SERVER_URL="http://183.82.117.36:33003"
KEYCLOAK_CLIENT_ID="hrms-backend-api"
KEYCLOAK_CLIENT_SECRET="your-keycloak-client-secret"

# Redis Configuration (For BullMQ queues)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Server Port
PORT=5005
NODE_ENV="development"
