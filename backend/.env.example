# Database Configuration (Supabase PostgreSQL Local)
# Since Supabase is local, default port for PostgreSQL is usually 54322
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres?schema=hrms"

# Keycloak Configuration (Local)
KEYCLOAK_REALM="hrms"
KEYCLOAK_AUTH_SERVER_URL="http://localhost:8080"
KEYCLOAK_CLIENT_ID="hrms-backend-api"
KEYCLOAK_CLIENT_SECRET="your-keycloak-client-secret"

# Redis Configuration (For BullMQ queues)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Server Port
PORT=5000
NODE_ENV="development"
