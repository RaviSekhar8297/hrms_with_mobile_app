# =============================================================================
# Frontend env — works on office LAN (HTTP) and VPS (HTTPS via nginx)
# Copy to .env and adjust. Restart `next dev` / `next start` after changes.
# =============================================================================

# Express API that Next.js proxies /api/* to (server-side only, never sent to the browser)
# Office LAN or VPS with backend on the same machine:
API_BACKEND_URL=http://127.0.0.1:5005
# If the frontend VPS must reach an office-LAN backend instead:
# API_BACKEND_URL=http://183.82.117.36:5005

# Browser API origin. Leave EMPTY so the browser always calls same-origin /api
# (Next.js rewrite on LAN, nginx on VPS). Only set this if you must bypass the proxy.
NEXT_PUBLIC_API_URL=

# Office-LAN Supabase Kong / API gateway (server-side rewrite target for /supabase/*)
# Default local Supabase Kong is often :8000; this office instance is on :8800.
SUPABASE_INTERNAL_URL=http://183.82.117.36:8800
# Pure local docker supabase:
# SUPABASE_INTERNAL_URL=http://127.0.0.1:8000

# Optional browser-facing Supabase URL. Leave empty to use same-origin /supabase
# Office LAN direct:  NEXT_PUBLIC_SUPABASE_URL=http://183.82.117.36:8800
# VPS via nginx:      NEXT_PUBLIC_SUPABASE_URL=https://newhrms.brihaspathi.in/supabase
NEXT_PUBLIC_SUPABASE_URL=

# Keycloak on office LAN (server-side rewrite target for /keycloak/*)
KEYCLOAK_INTERNAL_URL=http://183.82.117.36:33003
# Local Keycloak:
# KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080

# Hosts allowed to open the Next.js dev server (comma-separated, no protocol)
# Include BOTH office LAN IPs and the VPS host/domain.
NEXT_PUBLIC_DEV_ORIGINS=173.249.6.61,newhrms.brihaspathi.in,172.21.2.137,172.21.4.18,183.82.117.36
