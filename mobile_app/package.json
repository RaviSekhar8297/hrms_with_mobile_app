    "expo-system-ui": "~4.0.9",
    "expo-updates": "~0.27.5",
    "lucide-react-native": "^0.395.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
