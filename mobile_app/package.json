  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "EXPO_NO_DEV_TOOLS=1 ELECTRON_DISABLE_SANDBOX=1 expo start --port 8088",
    "tunnel": "EXPO_NO_DEV_TOOLS=1 ELECTRON_DISABLE_SANDBOX=1 expo start --tunnel --port 8088",
